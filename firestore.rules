rules_version = '2';

// Estas reglas NO corren en el navegador: se despliegan a Google y se evalúan
// en sus servidores, en cada operación. Aunque alguien reescriba el JavaScript
// del cliente o pegue requests a mano, no puede saltearlas.
//
// request.auth lo arma Google verificando la firma del ID token de la sesión.
// No se puede falsear desde el cliente.
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario, y solo ese usuario, entra a su propia carpeta de tareas.
    match /users/{uid}/tasks/{taskId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && esTareaValida();
    }

    // Preferencias de avisos. El chat de Telegram lo escribe el servidor
    // (que usa la cuenta de servicio y se saltea estas reglas), no el
    // navegador: desde el cliente solo se puede leer y desconectar.
    match /users/{uid}/config/avisos {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && esConfigValida();
    }

    // El nombre que la persona elige mostrar. Va en un documento aparte del de
    // avisos a propósito: si estuvieran juntos, escribir el nombre obligaría a
    // mandar también el chat de Telegram, y la regla de arriba no lo permite.
    match /users/{uid}/config/perfil {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && esPerfilValido();
    }

    // Cualquier otro documento de configuración queda cerrado.
    match /users/{uid}/config/{doc} {
      allow read, write: if false;
    }

    // Códigos de vinculación de Telegram: los crea el navegador y los
    // consume el servidor. Nadie puede leer los de otra persona.
    match /vinculos/{codigo} {
      allow get, create, delete: if request.auth != null;
      allow list, update: if false;
    }

    // Todo lo que no esté declarado arriba queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }

  function isOwner(uid) {
    return request.auth != null && request.auth.uid == uid;
  }

  // Desde el navegador solo se puede apagar los avisos o desconectar el chat.
  // Poner un chat de Telegram es cosa del servidor, que verifica de verdad
  // que ese chat le escribió al bot.
  function esConfigValida() {
    let d = request.resource.data;
    return d.get('telegramChatId', null) == null
      && (d.get('avisos', false) is bool);
  }

  // Solo un nombre, y acotado: esto lo escribe el navegador.
  function esPerfilValido() {
    let d = request.resource.data;
    return d.get('nombre', '') is string
      && d.get('nombre', '').size() <= 60;
  }

  // Validación de forma en el servidor: que un cliente modificado no pueda
  // escribir basura ni documentos gigantes en la base.
  //
  // ⚠️ SIEMPRE usar d.get('campo', default) para todo lo que no sea
  // obligatorio desde el día uno. Leer un campo que no existe en el documento
  // hace fallar la regla ENTERA y Firestore rechaza la escritura.
  // Esto ya rompió una vez: al agregar dueTime, las tareas viejas que no lo
  // tenían dejaron de poder tacharse.
  function esTareaValida() {
    let d = request.resource.data;
    return d.title is string
      && d.title.size() > 0
      && d.title.size() <= 200
      && d.get('description', '') is string
      && d.get('description', '').size() <= 5000
      && d.status in ['todo', 'doing', 'done']
      && d.createdAt is number
      && (d.get('startedAt', null) == null || d.get('startedAt', null) is number)
      && (d.get('finishedAt', null) == null || d.get('finishedAt', null) is number)
      && (d.get('dueDate', null) == null || d.get('dueDate', null) is string)
      && (d.get('dueTime', null) == null || d.get('dueTime', null) is string)
      && d.get('notify', false) is bool
      && (d.get('notifyBeforeMin', null) == null
          || (d.get('notifyBeforeMin', null) is int
              && d.get('notifyBeforeMin', 0) >= 0
              && d.get('notifyBeforeMin', 0) <= 10080))
      && (d.get('nextNotifyAt', null) == null || d.get('nextNotifyAt', null) is int)
      && d.get('notes', []) is list
      && d.get('notes', []).size() <= 200;
  }
}
