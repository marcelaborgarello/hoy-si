# Copiá este archivo a .env y completá con los datos de tu app web de Firebase.
# Los sacás con:  firebase apps:sdkconfig WEB --project <tu-proyecto>
# o desde la consola: Configuración del proyecto -> Tus apps -> Web.
#
# Si dejás esto vacío o con los placeholders, la app igual funciona:
# guarda todo en localStorage del navegador.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# SECRETOS DEL SERVIDOR — ojo acá.
# Estas NO llevan prefijo VITE_ y no deben llevarlo NUNCA: con el prefijo,
# Vite las mete dentro del JavaScript que descarga el navegador y quedan
# públicas. Sin prefijo, solo las ven las funciones de /api.
# En Vercel se cargan con visibility "secret" (al revés que las VITE_).
# ---------------------------------------------------------------------------

# Token del bot, te lo da @BotFather. Con esto se mandan mensajes en su nombre.
TELEGRAM_BOT_TOKEN=

# Clave inventada por nosotros para que solo Telegram pueda llamar al webhook.
# Poné cualquier cadena larga y al azar.
TELEGRAM_WEBHOOK_SECRET=
