{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "types": ["node"],

    /**
     * NodeNext es lo que hace que TypeScript valide las reglas de módulos de
     * Node de verdad. Con esto, un import relativo sin extensión .js es un
     * ERROR DE COMPILACIÓN y no una función que revienta en producción.
     * Antes la carpeta api/ no la revisaba ningún tsconfig.
     */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo"
  },
  "include": ["api"]
}
